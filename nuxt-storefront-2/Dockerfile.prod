# ===== Stage 1: Build =====
FROM node:20-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@10

COPY package.json pnpm-lock.yaml ./
COPY .npmrc ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG NUXT_PUBLIC_MEDUSA_BACKEND_URL
ARG NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ARG NUXT_PUBLIC_STRIPE_KEY
ENV NUXT_PUBLIC_MEDUSA_BACKEND_URL=$NUXT_PUBLIC_MEDUSA_BACKEND_URL
ENV NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=$NUXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY
ENV NUXT_PUBLIC_STRIPE_KEY=$NUXT_PUBLIC_STRIPE_KEY

RUN NODE_OPTIONS="--max-old-space-size=3072" pnpm run build

# ===== Stage 2: Production runner =====
FROM node:20-alpine AS runner

WORKDIR /app

# Nuxt build output (.output) sudah self-contained, termasuk node_modules yang dibutuhkan
COPY --from=builder /app/.output ./.output

EXPOSE 3000

ENV NITRO_PORT=3000
ENV NITRO_HOST=0.0.0.0

CMD ["node", ".output/server/index.mjs"]
